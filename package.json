{
  "name": "openinquiry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A focused demonstration of publisher-controlled knowledge access built on WebMCP.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run verify:demo-client-bundle",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:production": "OPENINQUIRY_TEST_PRODUCTION=1 playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:watch": "vitest",
    "verify:profile-runtime": "node --experimental-strip-types src/lib/profile/conformance.ts",
    "verify:webmcp-runtime": "node --test src/lib/webmcp/__tests__/runtime.test.ts",
    "verify:demo-client-boundary": "node --experimental-strip-types scripts/verify-demo-client-boundary.ts --source",
    "verify:demo-client-bundle": "node --experimental-strip-types scripts/verify-demo-client-boundary.ts --source --bundle",
    "verify:demo-client-dev-bundle": "node --experimental-strip-types scripts/verify-demo-client-boundary.ts --source --dev-bundle",
    "verify:repository": "node --experimental-strip-types scripts/verify-repository.ts",
    "verify:profile-schema": "node --test tests/verification/profile-schema-validator.test.mjs",
    "verify:evaluator": "node --experimental-strip-types evaluator/self-test.mjs",
    "verify": "npm run check",
    "check": "npm run lint && npm run typecheck && npm run test && npm run verify:repository && npm run verify:demo-client-boundary && npm run verify:profile-runtime && npm run verify:webmcp-runtime && npm run verify:profile-schema && npm run verify:evaluator",
    "dev:sites": "vinext dev --port 3001",
    "build:sites": "vinext build && npm run verify:sites-artifact",
    "start:sites": "wrangler dev --config dist/server/wrangler.json",
    "verify:sites-artifact": "node --experimental-strip-types scripts/verify-sites-artifact.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.3",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "wrangler": "^4.128.0"
  }
}
